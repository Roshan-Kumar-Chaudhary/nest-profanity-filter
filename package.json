{
  "name": "nepali-english-profanity-filter",
  "version": "1.0.1",
  "description": "NestJS profanity filter (English + Nepali) with custom dictionaries",
  "license": "MIT",
  "author": "Roshan Chaudhary",
  "repository": {
    "type": "git",
    "url": "https://github.com/Roshan-Kumar-Chaudhary/nest-profanity-filter"
  },
  "keywords": [
    "nestjs",
    "profanity",
    "filter",
    "nepali",
    "english"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
